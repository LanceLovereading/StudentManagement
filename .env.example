# 数据库连接串。
# 本地开发：任意 Postgres（见 README 部署章节的本地引导）。
# Vercel 部署（Neon 为例）：
#   - 运行时（Vercel 环境变量）用 pooled 串（主机带 -pooler）+ &pgbouncer=true
#   - 建表/种子（本机跑 db:push / db:seed）用 direct 串（不带 -pooler）
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.ap-southeast-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
SESSION_SECRET="replace-with-a-random-string-at-least-32-chars-long!!"
# 部署到 HTTPS 时设置（如 https://your-app.vercel.app），会话 cookie 自动带 Secure；
# 本地 HTTP 演示必须留空——Safari 拒绝在明文 HTTP 上保存带 Secure 的 cookie。
# APP_URL="https://your-app.vercel.app"

# LLM 跟进起草（可选：任何 OpenAI 兼容接口）。不配置时跟进话术降级为空白框，流程照常走通
# LLM_BASE_URL="https://api.openai.com/v1"
# LLM_API_KEY="sk-..."
# LLM_MODEL="gpt-4o-mini"
